# API
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Supabase Postgres connection string for persistent storage.
# Use the Supabase session pooler URL (port 5432) with sslmode=require for Render.
# Without it, the API uses an in-memory store for local development.
DATABASE_URL=

# Comma-separated member id and display name pairs.
TEAM_MEMBERS=member-1:팀원 1,member-2:팀원 2,member-3:팀원 3,member-4:팀원 4

# Keep this key on the NestJS API only. Never prefix it with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend-only API URL. Set this to the Render API URL in Vercel.
VITE_API_URL=http://localhost:3001
